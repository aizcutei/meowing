{
  "name": "meowing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless Clash -> sing-box subscription converter with download and QR transfer",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "cf-typegen": "wrangler types",
    "pretest": "./scripts/fetch-singbox.sh"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.135.0"
  }
}
